{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMAX Human Signal",
  "type": "object",
  "required": [
    "signal_id",
    "sample_id",
    "source_type",
    "raw_text",
    "review_context",
    "mapping_status",
    "learning_permission"
  ],
  "properties": {
    "signal_id": {"type": "string"},
    "sample_id": {"type": "string"},
    "evaluation_id": {"type": ["string", "null"]},
    "source_type": {
      "enum": [
        "human_dataset",
        "independent_human_eval",
        "evaluation_feedback",
        "human_confirmation"
      ]
    },
    "raw_text": {"type": "string"},
    "review_context": {
      "enum": ["blind", "ai_assisted", "not_applicable", "unknown"]
    },
    "mapping_status": {"enum": ["existing", "partial", "unmapped", "needs_clarification"]},
    "normalized_labels": {"type": "array", "items": {"type": "object"}},
    "dimension_proposal": {"type": ["object", "null"]},
    "learning_permission": {"type": "boolean"},
    "data_partition": {"enum": ["train", "calibration", "holdout", "unassigned", null]},
    "normalizer_id": {"type": ["string", "null"]},
    "normalizer_version": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "preprocess_id": {"type": ["string", "null"]},
    "feed_asset_id": {"type": ["string", "null"]},
    "prompt_asset_ids": {"type": "array", "items": {"type": "string"}},
    "result_asset_id": {"type": ["string", "null"]},
    "human_score_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "human_verdict": {"type": ["string", "null"]},
    "annotations": {
      "type": "object",
      "description": "Optional time ranges, ROI, bbox, mask, keypoint or other trainer-ready supervision."
    }
  },
  "additionalProperties": true
}
