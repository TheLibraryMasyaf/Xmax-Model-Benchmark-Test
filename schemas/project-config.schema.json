{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Evaluation Project Config",
  "type": "object",
  "required": [
    "project_id",
    "benchmark_path",
    "scenario_pack_path",
    "operation_recipe_path",
    "artifact_root",
    "manifest_root",
    "database_path",
    "generation_modes",
    "paid_run_requires_approval"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "project_id": {"type": "string", "minLength": 1},
    "benchmark_path": {"type": "string", "minLength": 1},
    "scenario_pack_path": {"type": "string", "minLength": 1},
    "operation_recipe_path": {"type": "string", "minLength": 1},
    "network_profile_path": {"type": "string", "minLength": 1},
    "default_network_profile_id": {"type": "string", "minLength": 1},
    "default_max_network_retries": {"type": "integer", "minimum": 0, "maximum": 5},
    "artifact_root": {"type": "string", "minLength": 1},
    "manifest_root": {"type": "string", "minLength": 1},
    "database_path": {"type": "string", "minLength": 1},
    "default_model": {"type": "string"},
    "default_offline_provider": {"enum": ["xmax", "decart"]},
    "default_repeats": {"type": "integer", "minimum": 1},
    "xmax_api_base_url": {"type": "string", "format": "uri"},
    "xmax_api_key_file": {"type": "string", "minLength": 1},
    "xmax_offline_quality": {"enum": ["sd", "hd"]},
    "xmax_offline_fps": {"type": ["integer", "null"], "minimum": 8},
    "decart_api_base_url": {"type": "string", "format": "uri"},
    "decart_api_key_env": {"type": "string", "minLength": 1},
    "decart_model": {"const": "lucy-2.5"},
    "decart_resolution": {"const": "720p"},
    "decart_enhance_prompt": {"type": "boolean"},
    "decart_self_anchor": {"type": "boolean"},
    "decart_poll_interval_s": {"type": "number", "minimum": 0},
    "decart_timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600},
    "decart_cost_usd_per_second": {"type": "number", "minimum": 0},
    "generation_modes": {
      "type": "array",
      "items": {"enum": ["offline", "realtime"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "paid_run_requires_approval": {"const": true},
    "codex": {
      "type": "object",
      "required": ["binary", "timeout_seconds", "max_retries"],
      "properties": {
        "binary": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
