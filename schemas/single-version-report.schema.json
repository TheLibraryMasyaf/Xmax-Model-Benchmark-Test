{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMAX Single Version Report",
  "type": "object",
  "required": [
    "report_schema_version",
    "report_id",
    "status",
    "model_version",
    "run_batch_id",
    "evaluation_batch_id",
    "benchmark_version",
    "coverage",
    "scores",
    "dimension_results",
    "criterion_results",
    "reporting_metrics",
    "evaluation_requirement_results",
    "case_results",
    "strengths",
    "weaknesses",
    "priorities",
    "credibility",
    "analysis_required",
    "audit"
  ],
  "properties": {
    "report_schema_version": {"const": "single-version-report/1.2"},
    "report_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial"]},
    "model_version": {"type": "string", "minLength": 1},
    "run_batch_id": {"type": "string", "minLength": 1},
    "evaluation_batch_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string"},
    "coverage": {"type": "object"},
    "scores": {"type": "object"},
    "dimension_results": {"type": "array", "items": {"type": "object"}},
    "criterion_results": {"type": "array", "items": {"type": "object"}},
    "reporting_metrics": {
      "type": "object",
      "required": ["summary_version", "P.2", "P.3", "P.4", "RP.1", "RP.2", "RP.3"],
      "properties": {
        "summary_version": {"const": "xmax-batch-reporting-metrics/1.1"},
        "P.2": {"type": "object"},
        "P.3": {"type": "object"},
        "P.4": {"type": "object"},
        "RP.1": {"type": "object"},
        "RP.2": {"type": "object"},
        "RP.3": {"type": "object"}
      },
      "additionalProperties": false
    },
    "evaluation_requirement_results": {
      "type": "object",
      "required": ["policy", "scoring_criteria", "reporting_metrics", "requirement_count"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "scoring_criteria": {"type": "array", "items": {"type": "object"}},
        "reporting_metrics": {"type": "array", "items": {"type": "object"}},
        "requirement_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "case_results": {"type": "array", "items": {"type": "object"}},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "weaknesses": {"type": "array", "items": {"type": "object"}},
    "priorities": {
      "type": "object",
      "required": ["p0", "p1", "p2"],
      "properties": {
        "p0": {"type": "array", "items": {"type": "object"}},
        "p1": {"type": "array", "items": {"type": "object"}},
        "p2": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "credibility": {
      "type": "object",
      "required": ["status", "issues"],
      "properties": {
        "status": {"enum": ["credible_with_warnings", "diagnostic"]},
        "issues": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "analysis_required": {"const": true},
    "audit": {"type": "object"}
  },
  "additionalProperties": true
}
