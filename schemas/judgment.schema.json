{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMAX Judgment",
  "type": "object",
  "required": [
    "evaluation_id",
    "run_id",
    "benchmark_version",
    "dimension_id",
    "dimension_version",
    "judge_id",
    "judge_version",
    "verdict",
    "evidence",
    "criterion_results"
  ],
  "properties": {
    "evaluation_id": {"type": "string"},
    "run_id": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "dimension_id": {"type": "string"},
    "dimension_version": {"type": "string"},
    "judge_id": {"type": "string"},
    "judge_version": {"type": "string"},
    "verdict": {"type": "string"},
    "score": {"type": ["number", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "assessable": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_s": {"type": "number"},
          "end_s": {"type": "number"},
          "region": {"type": ["string", "object", "null"]},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "raw_metrics": {"type": "object"},
    "raw_output_uri": {"type": ["string", "null"]},
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterion_result"}
    }
  },
  "$defs": {
    "criterion_result": {
      "type": "object",
      "required": [
        "criterion_id",
        "verdict",
        "score",
        "confidence",
        "assessable",
        "evidence"
      ],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "verdict": {"type": "string", "minLength": 1},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "assessable": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "start_s": {"type": "number"},
              "end_s": {"type": "number"},
              "region": {"type": ["string", "object", "null"]},
              "description": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "raw_metrics": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
