{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMAX Operation Recipe Pack",
  "type": "object",
  "required": ["recipe_pack_id", "version", "recipes"],
  "properties": {
    "$schema": {"type": "string"},
    "recipe_pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recipe_id",
          "version",
          "play_names",
          "default_generation_mode",
          "allowed_generation_modes",
          "prompt_template",
          "edited_video_role",
          "expected_audio_source_role",
          "bindings",
          "evaluation_contract"
        ],
        "properties": {
          "recipe_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "play_names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "default_generation_mode": {"enum": ["offline", "realtime"]},
          "allowed_generation_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["offline", "realtime"]}
          },
          "prompt_template": {"type": "string", "minLength": 1},
          "edited_video_role": {"enum": ["feed_video", "prompt_video", "realtime_input_stream"]},
          "expected_audio_source_role": {"enum": ["feed_video", "prompt_video", "realtime_input_stream"]},
          "evaluation_contract": {
            "type": "object",
            "required": [
              "operation_summary",
              "result_expectation",
              "role_semantics",
              "must_preserve",
              "must_change"
            ],
            "properties": {
              "operation_summary": {"type": "string", "minLength": 1},
              "result_expectation": {"type": "string", "minLength": 1},
              "role_semantics": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "must_preserve": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "must_change": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "bindings": {
            "type": "object",
            "properties": {
              "offline": {
                "type": "object",
                "required": ["refVideoPath"],
                "properties": {
                  "refVideoPath": {"enum": ["feed_video", "prompt_video"]},
                  "refImagePath": {"enum": ["prompt_image", "feed_capture", "none"]}
                },
                "additionalProperties": false
              },
              "realtime": {
                "type": "object",
                "required": ["input_method"],
                "properties": {
                  "input_method": {"enum": ["connectMedia", "connectCamera", "connect"]},
                  "ref_image_role": {"enum": ["prompt_image", "none"]},
                  "interaction_profile_id": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
