{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XMAX Evaluation Result",
  "type": "object",
  "required": [
    "evaluation_id",
    "evaluation_batch_id",
    "run_id",
    "benchmark_version",
    "scenario_pack_version",
    "score_schema_version",
    "criterion_results",
    "dimension_results",
    "weight_resolution",
    "case_score_percent"
  ],
  "properties": {
    "evaluation_id": {"type": "string"},
    "evaluation_batch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "scenario_pack_version": {"type": "string"},
    "score_schema_version": {"type": "string"},
    "criterion_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/fused_criterion_result"}
    },
    "dimension_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/derived_dimension_result"}
    },
    "canonical_score": {"type": ["number", "null"]},
    "scenario_score": {"type": ["number", "null"]},
    "case_score_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "score_readiness": {
      "enum": ["ready", "missing_scene_weight_rule", "incomplete_evidence"]
    },
    "score_display_format": {"const": "percentage"},
    "weight_resolution": {
      "type": "object",
      "required": [
        "base_profile_id",
        "base_profile_version",
        "matched_rule_ids",
        "matched_rule_versions",
        "scene_tags_hash",
        "effective_weights",
        "excluded_dimensions",
        "rule_excluded_dimensions"
      ],
      "properties": {
        "base_profile_id": {"type": "string"},
        "base_profile_version": {"type": "string"},
        "matched_rule_ids": {"type": "array", "items": {"type": "string"}},
        "matched_rule_versions": {"type": "array", "items": {"type": "string"}},
        "scene_tags_hash": {"type": "string"},
        "effective_weights": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "excluded_dimensions": {"type": "array", "items": {"type": "string"}},
        "rule_excluded_dimensions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applied_gate_ids": {"type": "array", "items": {"type": "string"}},
    "final_verdict": {"type": ["string", "null"]}
  },
  "$defs": {
    "fused_criterion_result": {
      "type": "object",
      "required": [
        "dimension_id",
        "criterion_id",
        "score",
        "score_percent",
        "assessable",
        "applicable",
        "coverage_status",
        "judges",
        "judge_versions",
        "evidence"
      ],
      "properties": {
        "dimension_id": {"type": "string"},
        "criterion_id": {"type": "string"},
        "criterion_name": {"type": "string"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
        "score_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "assessable": {"type": "boolean"},
        "applicable": {"type": "boolean"},
        "coverage_status": {"enum": ["assessed", "unassessable", "uncovered", "not_applicable"]},
        "aggregation_scope": {
          "enum": ["run", "repeat_group", "cross_input_group", "batch"]
        },
        "judge_scores": {"type": "array", "items": {"type": "object"}},
        "raw_metrics": {"type": "array", "items": {"type": "object"}},
        "judges": {"type": "array", "items": {"type": "string"}},
        "judge_versions": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "derived_dimension_result": {
      "type": "object",
      "required": [
        "dimension_id",
        "score",
        "score_percent",
        "assessable",
        "applicable",
        "criterion_count",
        "assessable_criterion_count",
        "coverage_complete",
        "criterion_results"
      ],
      "properties": {
        "dimension_id": {"type": "string"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
        "score_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "assessable": {"type": "boolean"},
        "applicable": {"type": "boolean"},
        "criterion_count": {"type": "integer", "minimum": 0},
        "assessable_criterion_count": {"type": "integer", "minimum": 0},
        "coverage_complete": {"type": "boolean"},
        "criterion_results": {
          "type": "array",
          "items": {"$ref": "#/$defs/fused_criterion_result"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
