      "sample_fps": 30,
      "segments": [
        {"start_ms": 500, "duration_ms": 1000, "from": [0.25, 0.50], "to": [0.75, 0.50], "fingers": 1},
        {"start_ms": 2000, "duration_ms": 1000, "from": [0.50, 0.25], "to": [0.50, 0.75], "fingers": 1}
      ]
    },
    {
      "profile_id": "pointer-track-30fps-v2",
      "version": "0.2.0",
      "event_kind": "pointer_tracks",
      "sample_fps": 30,
      "segments": [],
      "randomization": {
        "kind": "seeded_user_swipes",
        "seed_scope": "case",
        "swipe_count": [4, 6],
        "start_delay_ms": [180, 360],
        "duration_ms": [260, 520],
        "gap_ms": [80, 200],
        "end_padding_ms": 180,
        "edge_margin": 0.08,
