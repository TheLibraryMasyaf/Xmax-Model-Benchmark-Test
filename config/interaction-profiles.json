{
  "$schema": "../schemas/interaction-profiles.schema.json",
  "profile_pack_id": "xmax-default-realtime-interactions",
  "version": "0.2.0",
  "profiles": [
    {
      "profile_id": "pointer-track-30fps-v1",
      "version": "0.1.0",
