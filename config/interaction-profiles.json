        "curvature": [-0.18, 0.18],
        "jitter": 0.008,
        "easing": ["ease_in_out", "ease_out", "linear"]
      }
    },
    {
      "profile_id": "camera-gesture-v1",
      "version": "0.1.0",
      "event_kind": "input_stream_gesture",
      "sample_fps": 30,
      "segments": []
    }
  ]
