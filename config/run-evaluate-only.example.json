{
  "$schema": "../schemas/run-request.schema.json",
  "request_id": "replace-evaluate-only",
  "stages": ["preprocess", "evaluate"],
  "stage_inputs": {
    "preprocess": [
      {
        "selector_id": "replace-preprocess-run-selector",
        "state": "request",
        "entity_type": "run_batch",
        "match": {"ids": ["replace-run-batch-id"]}
      }
    ],
    "evaluate": [
      {
        "selector_id": "replace-evaluate-run-selector",
        "state": "request",
        "entity_type": "run_batch",
        "match": {"ids": ["replace-run-batch-id"]}
      }
    ]
  },
  "dependency_policy": "explicit_only",
  "missing_input_policy": "error",
  "sync_policy": "none",
  "existing_results_request_path": null,
  "benchmark_path": "BENCHMARK.md",
  "scenario_pack_path": "config/scenarios.json",
  "dry_run": true,
  "smoke_limit": null,
  "manifest_directory": "var/manifests"
}
