{
  "$schema": "../schemas/run-request.schema.json",
  "request_id": "configure-before-running",
  "stages": ["ingest"],
  "stage_inputs": {
    "ingest": [
      {
        "selector_id": "configure-asset-source",
        "state": "request",
        "entity_type": "source_record",
        "match": {"ids": ["configure-me"]}
      }
    ]
  },
  "dependency_policy": "explicit_only",
  "missing_input_policy": "error",
  "sync_policy": "none",
  "benchmark_path": "BENCHMARK.md",
  "scenario_pack_path": "config/scenarios.json",
  "generation_modes": ["offline", "realtime"],
  "execution_mode": "streaming",
  "pipeline_queue_size": 4,
  "repeat_count": 5,
  "network_profile_id": "common-tun-webrtc-v1",
  "max_network_retries": 3,
  "dry_run": true,
  "filters": {},
  "manifest_directory": "var/manifests"
}
